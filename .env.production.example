# Example production environment variables (DO NOT COMMIT SECRETS)
# Copy to app/backend/.env or set as host environment variables

PORT=4000
NODE_ENV=production
DB_URL=mongodb+srv://<user>:<password>@cluster0.mongodb.net/standor?retryWrites=true&w=majority
CLIENT_URL=https://your-frontend.pages.dev
JWT_SECRET=replace_with_a_long_secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-frontend.pages.dev/api/auth/google/callback
BACKEND_URL=https://api.yourdomain.com

# SMTP (if used)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
